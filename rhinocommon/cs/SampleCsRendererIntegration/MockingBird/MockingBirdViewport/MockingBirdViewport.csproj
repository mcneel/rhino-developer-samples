<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net48</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <RootNamespace>MockingBirdViewport</RootNamespace>
    <AssemblyName>MockingBirdViewport</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\..\..\bin\</OutputPath>
    <NoWarn>NU1701</NoWarn>
    <Company>Robert McNeel &amp; Associates</Company>
    <Copyright>Copyright © 2013-2026, Robert McNeel &amp; Associates</Copyright>
    <Version>9.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="9.0.26146.14285-wip" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
