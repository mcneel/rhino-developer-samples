<Project>
  <!-- Package versions for every sample in this folder (central package management): bump them here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Rhino3dm" Version="9.2.0-beta.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="RhinoCommon" Version="7.0.20314.3001" />
  </ItemGroup>
</Project>
